      "boundElements": null,
      "updated": 1780853681438,
      "link": null,
      "locked": false,
      "text": "The service collects alerts within a short time window (say 30 seconds),\ngroups them by labels like cluster or service, and sends one notification per\ngroup instead of one per server.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The service collects alerts within a short time window (say 30 seconds), groups them by labels like cluster or service, and sends one notification per group instead of one per server.",
      "autoResize": false,
      "lineHeight": 1.25
    },
